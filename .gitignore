# ==========================================
# ERPM Frigorífico - .gitignore
# Node.js, TypeScript & PostgreSQL
# ==========================================

# Dependency Directories
node_modules/
jspm_packages/
web_modules/

# TypeScript Build & Output
dist/
build/
out/
*.tsbuildinfo

# Environment & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.pem
*.key
*.cert
secrets/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Database & Storage
*.sqlite
*.sqlite3
*.db
pg_data/
postgres-data/
dump.sql
*.dump

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE / Editor Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
.clover/

# Temporary Files & Cache
.cache/
.parcel-cache/
.eslintcache
.ts-node/
*.tmp
*.temp

# Docker / Microservices Local Overrides
docker-compose.override.yml
